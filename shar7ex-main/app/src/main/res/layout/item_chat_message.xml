<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- Outgoing Bubble Container -->
    <LinearLayout
        android:id="@+id/layoutOutgoing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="60dp"
        android:background="@drawable/bg_chat_outgoing"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvOutgoingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message text here"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- Media Attachment Card in Outgoing -->
        <LinearLayout
            android:id="@+id/cardOutgoingMedia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#22000000"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivOutgoingMediaPreview"
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_sharex_logo" />

            <TextView
                android:id="@+id/tvOutgoingMediaName"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="RAW_Photo.dng"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOutgoingQualityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_badge_hq"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="100% ORIGINAL"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvOutgoingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="12:45 PM • Sent"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Incoming Bubble Container -->
    <LinearLayout
        android:id="@+id/layoutIncoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_chat_incoming"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvIncomingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incoming message text"
            android:textColor="@color/text_primary_dark"
            android:textSize="14sp" />

        <!-- Media Attachment Card in Incoming -->
        <LinearLayout
            android:id="@+id/cardIncomingMedia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#22000000"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivIncomingMediaPreview"
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_sharex_logo" />

            <TextView
                android:id="@+id/tvIncomingMediaName"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="Cinematic_Alps_4K.mp4"
                android:textColor="@color/text_primary_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIncomingQualityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_badge_hq"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="100% ORIGINAL"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvIncomingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="12:46 PM"
            android:textColor="@color/text_secondary_dark"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
