<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Media &amp; Transfer Details"
            android:textColor="@color/text_primary_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCloseDetailsDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary_dark" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#242D3D" />

    <TextView
        android:id="@+id/tvDetailsFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="File: Cinematic_Alps_4K_60FPS.mp4"
        android:textColor="@color/text_primary_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDetailsSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Exact Size: 503,316,480 Bytes (480.0 MB)"
        android:textColor="@color/accent_cyan"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvDetailsResolution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Resolution: 3840 x 2160 (4K UHD 60FPS)"
        android:textColor="@color/text_secondary_dark"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvDetailsQualityState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Quality State: 100% Original Untouched"
        android:textColor="@color/accent_green"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDetailsChecksum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="SHA-256: E9A4B3C2D1F08876"
        android:textColor="@color/text_secondary_dark"
        android:textSize="12sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/tvDetailsExif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:padding="10dp"
        android:text="EXIF / Stream Info: Codec: HEVC/H.265 • 10-Bit Color"
        android:textColor="@color/text_secondary_dark"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Share Link:"
        android:textColor="@color/text_primary_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/tvShareLinkUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:text="https://m.sharex.link/file/alps4k"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnCopyShareLink"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_copy"
            app:tint="@color/accent_cyan" />

        <ImageView
            android:id="@+id/btnShareDetailsLink"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_share"
            app:tint="@color/accent_cyan" />

    </LinearLayout>

</LinearLayout>
