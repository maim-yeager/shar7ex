<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBarPicker"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#131923"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/ivPickerBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Media Gallery"
                android:textColor="@color/text_primary_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGallerySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select uncompressed photos &amp; videos"
                android:textColor="@color/text_secondary_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSelectAllToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:text="Select All"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Category Filter Chips Horizontal Scroll -->
    <HorizontalScrollView
        android:id="@+id/hsvCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBarPicker"
        android:background="#111620"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All Media"
                android:textColor="@color/white"
                app:chipBackgroundColor="#1D2635" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPhotos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 Photos"
                android:textColor="@color/white"
                app:chipBackgroundColor="#1D2635" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVideos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 4K Videos"
                android:textColor="@color/white"
                app:chipBackgroundColor="#1D2635" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLargeFiles"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💎 Large / RAW (>50MB)"
                android:textColor="@color/white"
                app:chipBackgroundColor="#1D2635" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Quality Preservation Mode Banner -->
    <LinearLayout
        android:id="@+id/qualitySelectionBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/hsvCategories"
        android:background="#161E2C"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quality Preservation Mode"
                android:textColor="@color/text_primary_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBatchTotalSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 MB selected"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/rgQualityMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbOriginalQuality"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/accent_cyan"
                android:checked="true"
                android:text="100% Original (Lossless)"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbCompressedMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/accent_amber"
                android:text="Compressed (Fast)"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp" />

        </RadioGroup>

        <TextView
            android:id="@+id/tvQualityWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="✨ High-Quality Mode preserves 100% original pixel data, color profiles, and EXIF metadata."
            android:textColor="@color/accent_green"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Main Media Gallery RecyclerView with Glide -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMediaGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomPickerAction"
        android:layout_below="@id/qualitySelectionBox"
        android:clipToPadding="false"
        android:padding="4dp"
        tools:listitem="@layout/item_media_grid" />

    <!-- Empty State Layout -->
    <LinearLayout
        android:id="@+id/layoutEmptyGallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Empty Gallery"
            android:src="@drawable/ic_gallery"
            app:tint="@color/text_secondary_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No media found in this filter"
            android:textColor="@color/text_secondary_dark"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Bottom Persistent Action Bar -->
    <LinearLayout
        android:id="@+id/bottomPickerAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#131923"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSendSelectedMedia"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_primary"
            android:enabled="false"
            android:text="Select Media to Share (0 Selected)"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
