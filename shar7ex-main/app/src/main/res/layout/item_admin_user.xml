<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivAdminUserAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:padding="8dp"
        android:src="@drawable/ic_user" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAdminUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alex Turner"
            android:textColor="@color/text_primary_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAdminUserMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="alex@media.com • UID: uid_1"
            android:textColor="@color/text_secondary_dark"
            android:textSize="11sp" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnToggleBlock"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_button_secondary"
        android:paddingHorizontal="14dp"
        android:text="Block"
        android:textAllCaps="false"
        android:textColor="@color/status_offline"
        android:textSize="12sp" />

</LinearLayout>
