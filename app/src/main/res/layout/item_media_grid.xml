<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMediaItem"
    android:layout_width="match_parent"
    android:layout_height="125dp"
    android:layout_margin="3dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#131923"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeColor="#243042"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- High Performance Glide Thumbnail -->
        <ImageView
            android:id="@+id/ivGridThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Media Thumbnail"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_card_dark" />

        <!-- Selected Gradient Overlay Scrim -->
        <View
            android:id="@+id/vSelectionScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#7300D2FF"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Top Right Selection CheckBox Badge -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:padding="4dp">

            <CheckBox
                android:id="@+id/cbMediaSelected"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:buttonTint="@color/accent_cyan"
                android:clickable="false"
                android:contentDescription="Select Media Item"
                android:focusable="false" />
        </RelativeLayout>

        <!-- Top Left 4K/HQ Badge -->
        <TextView
            android:id="@+id/tvGridHqBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_hq"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:text="4K HQ"
            android:textColor="@color/accent_cyan"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <!-- Bottom Left: Video Indicator with Duration -->
        <LinearLayout
            android:id="@+id/layoutVideoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_margin="5dp"
            android:background="#B3000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="Video Indicator"
                android:src="@drawable/ic_video"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvGridDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02:45"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Right: Size Badge & Preview Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGridSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#B3000000"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:text="48 MB"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="48.5 MB" />

            <ImageView
                android:id="@+id/btnQuickPreview"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:background="#B3000000"
                android:contentDescription="Preview Fullscreen"
                android:padding="4dp"
                android:src="@drawable/ic_info"
                app:tint="@color/text_primary_dark" />
        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
